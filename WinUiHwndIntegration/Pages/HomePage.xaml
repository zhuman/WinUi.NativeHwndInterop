<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUiHwndIntegration.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinUiHwndIntegration.Pages"
    xmlns:interop="using:WinUI.NativeHwndInterop"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <Page.Resources>
        <Storyboard x:Name="SlideStoryboard">
            <DoubleAnimation
                AutoReverse="True"
                Storyboard.TargetName="HostTransform"
                Storyboard.TargetProperty="TranslateX"
                From="0"
                To="240"
                Duration="0:0:1.5" />
        </Storyboard>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="24,16,24,16" Spacing="16">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Child HWND via ContentExternalOutputLink" />
            <TextBlock TextWrapping="WrapWholeWords">
                A WS_CHILD | WS_EX_LAYERED Win32 window is turned into a DirectComposition surface (CreateSurfaceFromHwnd),
                set as the root of a ContentExternalOutputLink (via IDCompositionTarget::SetRoot), and the link's
                PlacementVisual is parented into the XAML tree below. The badge in the corner is ordinary XAML drawn on top of it.
            </TextBlock>

            <StackPanel Orientation="Horizontal" Spacing="32">
                <RadioButtons
                    x:Name="CloakModeRadios"
                    Header="Cloak the real HWND"
                    SelectedIndex="0"
                    SelectionChanged="CloakModeRadios_SelectionChanged">
                    <x:String>Auto (cloak while moving/transformed)</x:String>
                    <x:String>Always cloaked</x:String>
                    <x:String>Never cloaked</x:String>
                </RadioButtons>
                <RadioButtons
                    x:Name="ClipModeRadios"
                    Header="SetWindowRgn on the HWND"
                    SelectedIndex="0"
                    SelectionChanged="ClipModeRadios_SelectionChanged">
                    <x:String>None</x:String>
                    <x:String>Clip to visible area (while uncloaked)</x:String>
                    <x:String>Debug: left half only</x:String>
                </RadioButtons>
                <StackPanel Spacing="8">
                    <TextBlock Text="Non-layout transforms" />
                    <Button x:Name="SlideButton" Click="SlideButton_Click" Content="Slide (Storyboard on RenderTransform)" />
                    <ToggleButton x:Name="RotateToggle" Click="RotateToggle_Click" Content="Rotate 6°" />
                </StackPanel>
            </StackPanel>

            <StackPanel Width="480" HorizontalAlignment="Left" Spacing="4">
                <Slider
                    x:Name="ChildAlphaSlider"
                    Header="Native HWND alpha (0-255)"
                    Minimum="0"
                    Maximum="255"
                    Value="255"
                    StepFrequency="1"
                    ValueChanged="ChildAlphaSlider_ValueChanged" />
                <TextBlock TextWrapping="Wrap" Text="Only affects the real HWND, not the redirected visual. Choose Never cloaked to test input and overlays. Alpha 0 may pass mouse input through the HWND; try 1 as well." />
                <TextBlock x:Name="AlphaErrorText" TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock
                x:Name="StatusText"
                FontFamily="Consolas"
                IsTextSelectionEnabled="True"
                TextWrapping="Wrap" />

            <Grid x:Name="HostContainer" HorizontalAlignment="Left">
                <Grid.RenderTransform>
                    <CompositeTransform x:Name="HostTransform" CenterX="240" CenterY="160" />
                </Grid.RenderTransform>
                <interop:NativeHwndHost
                    x:Name="HwndHostElement"
                    Width="480"
                    Height="320"
                    NativeAlpha="255"
                    ClipMode="None"
                    CloakMode="Auto" />
                <Border
                    Margin="0,0,-24,-16"
                    Padding="12,6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="4">
                    <TextBlock Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Text="XAML overlay on top of the HWND visual" />
                </Border>
            </Grid>

            <!-- Extra space so the host can be scrolled partially out of the viewport. -->
            <Border Height="600" />
        </StackPanel>
    </ScrollViewer>
</Page>
